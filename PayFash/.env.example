# =====================================================================
#  Copiez ce fichier en .env et renseignez vos propres valeurs.
#  Le .env n'est jamais versionne (voir .gitignore) : aucune cle reelle
#  ne doit apparaitre ici.
# =====================================================================

# ---- Serveur --------------------------------------------------------
PORT=3000
HOSTNAME=127.0.0.1

# ---- Base de donnees (MySQL / MariaDB) ------------------------------
DATABASE=moneytrack
DBUSER=root
DBPASSWORD=
DBPORT=3306
DIALECT=mysql

# ---- Signature des jetons -------------------------------------------
# Secret JWT. Generez une valeur longue et aleatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOCKEN=

# ---- Envoi d'e-mails (SMTP) -----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SENDER_NAME=MoneyTrack
EMAIL_REPLY_TO=
COMPANY_NAME=MoneyTrack
COMPANY_ADDRESS=

# =====================================================================
#  Module tontine (caisses 1, 2 et 4)
#  Tout est optionnel : les defauts ci-dessous sont ceux du code.
# =====================================================================

# Part prelevee par la plateforme sur chaque pot verse (0.01 = 1 %).
TONTINE_FRAIS_PLATEFORME=0.01

# Caution demandee a l'entree d'un groupe, en % du montant par periode.
TONTINE_CAUTION_DEFAUT=10

# Taux d'interet mensuel par defaut de la caisse de credit, en %.
TONTINE_TAUX_CREDIT_DEFAUT=5

# Client systeme qui encaisse les frais de plateforme.
# SANS CETTE VARIABLE, LES FRAIS N'ONT AUCUN DESTINATAIRE et ne sont pas
# preleves — silencieusement. Creez un client dedie et mettez son id ici.
TONTINE_CLIENT_PLATEFORME_ID=

# =====================================================================
#  Fapshi — agregateur de paiement mobile money (MTN MoMo, Orange Money)
#  https://fapshi.com
# =====================================================================

# sandbox | live. Le mode decide quelles cles sont lues : on ne melange
# jamais des identifiants de test avec une URL de production.
FAPSHI_MODE=sandbox

FAPSHI_BASE_URL_SANDBOX=https://sandbox.fapshi.com
FAPSHI_API_USER_SANDBOX=
FAPSHI_API_KEY_SANDBOX=

FAPSHI_BASE_URL_LIVE=https://live.fapshi.com
FAPSHI_API_USER_LIVE=
FAPSHI_API_KEY_LIVE=

# Montant minimal impose par Fapshi, en FCFA.
PAIEMENT_MONTANT_MIN=100

# URL publique du serveur, pour que Fapshi rappelle le webhook.
# Laissez vide en developpement local : Fapshi ne peut pas joindre une
# machine derriere un routeur, et l'application bascule alors sur
# GET /paiement/:reference/verifier plus la reconciliation periodique.
APP_URL=
