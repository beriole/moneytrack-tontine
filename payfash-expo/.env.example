# =====================================================================
#  Copiez ce fichier en .env (jamais versionne) et renseignez vos valeurs.
# =====================================================================

# ---- Backend --------------------------------------------------------
# URL du serveur MoneyTrack. Sur un telephone physique, mettez l'IP LAN de
# la machine qui fait tourner le backend — jamais localhost, qui designerait
# le telephone lui-meme.
#   emulateur Android  : http://10.0.2.2:3000
#   simulateur iOS/web : http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# ---- Assistant IA (Groq) --------------------------------------------
# https://console.groq.com/keys
# NB : une variable EXPO_PUBLIC_* est embarquee dans le bundle client, donc
# lisible par qui installe l'application. Pour de la production, proxifiez
# l'appel par le backend plutot que d'exposer la cle.
EXPO_PUBLIC_GROQ_API_KEY=gsk_votre_cle_ici
# Optionnel : modele Groq (defaut: llama-3.3-70b-versatile)
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
